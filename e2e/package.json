{
	"name": "score-my-recipe-e2e",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "End-to-end integration tests (Playwright) for Score My Recipe",
	"scripts": {
		"test": "playwright test",
		"test:headed": "playwright test --headed",
		"report": "playwright show-report",
		"install-browsers": "playwright install chromium",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check": "tsc --noEmit"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.55.0",
		"@types/node": "^25.6.0",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.1"
	}
}
