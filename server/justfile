# Server commands

# prefer bash
set shell := ["bash", "-uc"]

# this help
[default]
help:
    @just --list

# Refresh dependencies
refresh:
    uv sync --all-extras

# Run dev server
dev:
    uv run uvicorn api.api:app --reload

# Rebuild the Agribalyse CSV from the official XLSX export (uses cache)
fetch-agribalyse:
    uv run typer api/cli.py run fetch-agribalyse

# Run all checks
[group('quality')]
check: python_check test

[group('quality')]
python_check:
  uv run ruff check
  uv run ty check

# Run tests
[group('quality')]
test:
    uv run pytest -v

# Lint
[group('quality')]
lint:
    uv run ruff format